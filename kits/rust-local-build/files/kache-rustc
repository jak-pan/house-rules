#!/bin/sh
# One shared artifact store; runtime state isolated by compiler output directory.
set -eu
if [ -z "${KACHE_RUNTIME_DIR:-}" ]; then
    output_dir=${CARGO_TARGET_DIR:-$PWD}
    previous=
    for argument in "$@"; do
        if [ "$previous" = --out-dir ]; then output_dir=$argument; break; fi
        previous=$argument
    done
    case "$output_dir" in /*) ;; *) output_dir="$PWD/$output_dir" ;; esac
    runtime_key=$(printf '%s' "$output_dir" | /usr/bin/shasum -a 256 | /usr/bin/cut -c1-32)
    export KACHE_RUNTIME_DIR="@STATE_DIR@/$runtime_key"
fi
exec @KACHE_BIN@ "$@"
