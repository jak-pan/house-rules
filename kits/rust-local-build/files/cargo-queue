#!/usr/bin/perl
# Machine-wide cargo queue (operator 2026-10-04): one cargo command that compiles or runs code at a time, on the
# whole machine, with the build budget as its thread limit (total cores - efficiency cores - reserve; 6 on the
# M1 Max). Covers build, test, bench, run and the rest; read-only commands (metadata, tree, fetch, --version)
# pass straight through so editors are never blocked. A cargo started inside a queued one (a test running
# `cargo tree`) skips the queue instead of deadlocking. The lock is a kernel flock held by this process only:
# it frees the moment this process exits or is killed, also inside the Codex sandbox.
# Installed by House Rules kits/rust-local-build; remove with its uninstall script.
use strict; use warnings; use Fcntl qw(:flock); use POSIX qw(WNOHANG); use Time::HiRes qw(time);

my $real = $ENV{CARGO_QUEUE_REAL} || "$ENV{HOME}/.cargo/bin/cargo";   # CARGO_QUEUE_REAL/LOCK: wrapper tests only
my $lockfile = $ENV{CARGO_QUEUE_LOCK} || '@STATE_DIR@/cargo-queue.lock';
my %queued = map { $_ => 1 } qw(build b check c clippy test t bench run r doc d rustc rustdoc fix install);

# One toolchain for every local build (operator 2026-10-04: "everything on 101"): the dated nightly wins over
# repository pins (rust-toolchain.toml) and over +toolchain arguments; ~/.cargo/config.toml uses nightly-only
# settings (Cranelift, trim-paths) that stable toolchains reject.
my $toolchain = $ENV{CARGO_QUEUE_TOOLCHAIN} || '@TOOLCHAIN@';
if (@ARGV && $ARGV[0] =~ /^\+(.+)/) {
  print STDERR "cargo queue: using $toolchain instead of +$1\n" if $1 ne $toolchain && $1 ne 'nightly';
  shift @ARGV;
}
$ENV{RUSTUP_TOOLCHAIN} = $toolchain;

# The subcommand: the first argument that is not a toolchain (+nightly), an option, or an option's value.
my ($sub, $skip) = ('', 0);
for my $arg (@ARGV) {
  if ($skip) { $skip = 0; next }
  if ($arg =~ /^(-Z|--config|-C|--color)$/) { $skip = 1; next }
  next if $arg =~ /^[+-]/;
  $sub = $arg; last;
}
exec($real, @ARGV) or die "cargo queue: cannot run $real: $!\n"
  if !$queued{$sub} || $ENV{CARGO_QUEUE_HELD};

chomp(my $cores = `/usr/sbin/sysctl -n hw.ncpu 2>/dev/null` // '');
chomp(my $efficiency = `/usr/sbin/sysctl -n hw.perflevel1.logicalcpu 2>/dev/null` // '');
my $budget;
my $saved = '@STATE_DIR@/build-budget';   # last budget computed outside a sandbox
if ($cores =~ /^\d+$/ && $efficiency =~ /^\d+$/) {
  $budget = $cores - $efficiency - ($ENV{BUILD_RESERVE} // 2);
  if (open(my $out, '>', "$saved.$$")) { print $out "$budget\n"; close $out; rename("$saved.$$", $saved); }
} else {
  # The Codex sandbox refuses sysctl. Use the budget saved by the last unsandboxed cargo, else 6 (this Mac).
  my ($in, $line) = (undef, '');
  $line = <$in> // '' if open($in, '<', $saved);
  $budget = $line =~ /^(\d+)$/ ? $1 : 6;
  print STDERR "cargo queue: core counts unreadable here; using the saved budget $budget\n";
}
# Operator override: the file holds "<budget>" or "<budget> <expiry epoch seconds>"; an expired override is ignored.
# Delete the file to return to the computed budget.
if (open(my $ov, '<', '@STATE_DIR@/build-budget-override')) {
  my $line = <$ov> // '';
  $budget = $1 if $line =~ /^\s*(\d+)(?:\s+(\d+))?\s*$/ && (!defined $2 || time < $2);
}
$budget = 1 if $budget < 1;
$ENV{CARGO_BUILD_JOBS} = $budget;
$ENV{RUST_TEST_THREADS} = $budget
  unless ($ENV{RUST_TEST_THREADS} // '') =~ /^\d+$/ && $ENV{RUST_TEST_THREADS} < $budget;

open(my $lock, '>>', $lockfile) or die "cargo queue: cannot open $lockfile: $!\n";
my $t0 = time;
unless (flock($lock, LOCK_EX | LOCK_NB)) {
  print STDERR "cargo queue: another cargo is running; waiting\n";
  flock($lock, LOCK_EX) or die "cargo queue: cannot lock: $!\n";
  printf STDERR "cargo queue: started after %.0fs\n", time - $t0;
}
$ENV{CARGO_QUEUE_HELD} = 1;
# Hold limits (2026-10-05, after a hung test held the queue for 44 minutes): the real cargo runs in its own
# process group, so test binaries it starts can be stopped with it. The group is stopped when no process in it
# gains CPU time and none starts for CARGO_QUEUE_STALL_MIN minutes (a deadlocked or sleeping hang), or when the hold
# exceeds CARGO_QUEUE_MAX_HOLD_MIN minutes (a busy-looping hang). 0 disables a limit. Defaults (operator 2026-10-05,
# "3-5 mins without cpu progress and 40 minutes overall"): 5 and 40; a full suite takes about 35 minutes at most.
my $stall_limit = 60 * ($ENV{CARGO_QUEUE_STALL_MIN} // 5);
my $hold_limit = 60 * ($ENV{CARGO_QUEUE_MAX_HOLD_MIN} // 40);
my $pid = fork() // die "cargo queue: fork: $!\n";
if ($pid == 0) { setpgrp(0, 0); exec($real, @ARGV) or die "cargo queue: cannot run $real: $!\n"; }
$SIG{$_} = sub { kill $_[0], -$pid } for qw(INT TERM HUP);

# CPU seconds per process in the group, or undef when ps cannot list processes (the Codex sandbox refuses sysctl).
sub group_cpu {
  my @rows = `/bin/ps -axo pid=,pgid=,time= 2>/dev/null`;
  return undef unless @rows;
  my %cpu;
  for (@rows) {
    my ($proc, $group, $time) = split;
    next unless defined $time && $group == $pid;
    my ($days, $rest) = $time =~ /^(?:(\d+)-)?(.+)$/;
    my @parts = reverse split /:/, $rest;
    $cpu{$proc} = ($parts[0] // 0) + 60 * ($parts[1] // 0) + 3600 * ($parts[2] // 0) + 86400 * ($days // 0);
  }
  return \%cpu;
}

my ($held_since, $last_cpu, $last_progress, $next_check) = (time, {}, time, time + 5);
my $reason;
while (waitpid($pid, WNOHANG()) == 0) {
  select(undef, undef, undef, 0.2);   # exit is noticed within 0.2 s; the limits are checked every 5 s
  my $now = time;
  next if $now < $next_check;
  $next_check = $now + 5;
  if ($hold_limit && $now - $held_since > $hold_limit) {
    $reason = sprintf 'held the queue for %d minutes (CARGO_QUEUE_MAX_HOLD_MIN=%d)', ($now - $held_since) / 60, $hold_limit / 60;
  } elsif ($stall_limit && defined(my $cpu = group_cpu())) {
    # Progress: a process that is new, or that gained CPU time, since the last check.
    my $moved = grep { !exists $last_cpu->{$_} || $cpu->{$_} > $last_cpu->{$_} } keys %$cpu;
    $last_progress = $now if $moved;
    $last_cpu = $cpu;
    if (!$moved && $now - $last_progress > $stall_limit) {
      $reason = sprintf 'no CPU progress for %d minutes (CARGO_QUEUE_STALL_MIN=%d)', ($now - $last_progress) / 60, $stall_limit / 60;
    }
  }
  next unless $reason;
  print STDERR "cargo queue: queue hold limit: $reason; stopping cargo and the processes it started\n";
  kill 'TERM', -$pid;
  for (1 .. 10) { last if waitpid($pid, WNOHANG()) != 0; sleep 1 }
  kill 'KILL', -$pid;
  waitpid($pid, 0);
  exit 124;
}
exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
