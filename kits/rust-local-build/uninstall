#!/usr/bin/env bash
# Restore every file the kit replaced and remove files it created. A file changed after install is kept
# as a copy under kit-backups/modified-<time> before it is restored. Usage: uninstall <kit.conf>
set -euo pipefail
. "$(dirname "$0")/lib.sh"
manifest_only=
[ "${1:-}" = --manifest-only ] && { manifest_only=1; shift; }
saved_manifest=${MANIFEST:-}
load_conf "${1:-}"
[ -n "$manifest_only" ] && MANIFEST=$saved_manifest
[ -f "$MANIFEST" ] || { echo "not installed (no manifest at $MANIFEST)" >&2; exit 1; }
stamp=$(date -u +%Y%m%dT%H%M%SZ)
kept="$STATE_DIR/kit-backups/modified-$stamp"
# Reverse order: the last file installed is restored first.
tail -r "$MANIFEST" 2>/dev/null > "$MANIFEST.rev" || tac "$MANIFEST" > "$MANIFEST.rev"
while IFS=$'\t' read -r dst backup digest; do
  if [ -e "$dst" ] && [ "$(sha "$dst")" != "$digest" ]; then
    mkdir -p "$kept"; cp -pP "$dst" "$kept/$(printf '%s' "$dst" | tr / %)"
    echo "kept changed $dst in $kept"
  fi
  if [ "$backup" = NONE ]; then rm -f "$dst"; echo "removed $dst"
  else cp -pP "$backup" "$dst.kit.restore" && mv -f "$dst.kit.restore" "$dst"; echo "restored $dst"; fi
done < "$MANIFEST.rev"
rm -f "$MANIFEST.rev"
[ -n "$manifest_only" ] && rm -f "$MANIFEST" || mv "$MANIFEST" "$MANIFEST.uninstalled-$stamp"
echo "uninstalled"
