#!/bin/zsh
# task — git-native multi-agent task protocol (interim until a dedicated orchestrator).
# Every file has ONE writer; TASKS.md is generated; handoffs are immutable events.
set -euo pipefail

TASKS_DIR="${TASKS_DIR:-tasks}"
AGENT="${AGENT_NAME:-${USER:-agent}}"
now() { date -u +%Y-%m-%dT%H:%M:%SZ }
stamp() { date -u +%Y%m%d-%H%M%S }
die() { print -ru2 -- "$*"; exit 1; }

validate_id() {
  [[ "$1" =~ '^[0-9]{3,18}$' ]] && (( 10#$1 > 0 )) || die "bad task ID: expected a positive decimal ID of 3–18 digits"
}

validate_agent() {
  [[ "$1" =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' ]] || die "bad owner/agent: use letters, digits, dot, underscore or hyphen; start with a letter or digit"
}

usage() {
  cat <<'EOF'
usage: task <command>
  new "title" [P0|P1|P2|P3]     scaffold next NNN-slug/task.md (status: pending)
  claim NNN [owner] [--force]   set owner (default $AGENT_NAME/$USER) + status: active; --force takes over
  status NNN <state>            pending|active|review|blocked   (done: use `task done`)
  done NNN [--check] [--force]  closeout gate: handoff + design-doc migration; --check reports, writes nothing
  handoff NNN                   create immutable handoff file for this session
  release NNN                   require filled handoff, clear owner, return to pending
  index                         regenerate tasks/TASKS.md from frontmatter (idempotent)
  board                         print live board to stdout (does not write)
rules: task.md is edited ONLY by its owner; handoffs/ files are never edited after
creation; TASKS.md is never hand-edited — always `task index` after frontmatter changes
and commit task.md + TASKS.md together.
EOF
  exit 1
}

fm_get() { # fm_get <file> <key> — tolerates empty values ("key:")
  awk -v k="$2" 'f==1 && $0=="---"{exit} $0=="---"{f=1;next}
    f==1 && index($0,k":")==1 {
      sub("^"k":[ ]*",""); q=sprintf("%c",39)
      if (substr($0,1,1)==q && substr($0,length($0),1)==q) {
        $0=substr($0,2,length($0)-2); gsub(q q,q)
      }
      print; exit
    }' "$1"
}

fm_set() { # fm_set <file> <key> <value> — single-key replace inside frontmatter
  local f="$1" k="$2" v="$3" tmp
  tmp="$(mktemp "$(dirname "$f")/.task.XXXXXX")"
  TASK_FIELD_VALUE="$v" awk -v k="$k" '
    BEGIN{fm=0; v=ENVIRON["TASK_FIELD_VALUE"]}
    $0=="---"{n++; fm=(n==1)?1:0; print; next}
    fm==1 && index($0,k":")==1 {print k": "v; next}
    {print}' "$f" > "$tmp" && mv "$tmp" "$f"
}

task_dir() { # task_dir NNN
  validate_id "$1"
  local -a m
  m=("$TASKS_DIR"/"$1"-*(N/))
  (( ${#m} > 0 )) || { echo "no task $1 in $TASKS_DIR/" >&2; exit 1; }
  (( ${#m} == 1 )) || die "ambiguous task ID $1: ${#m} matching directories"
  echo "${m[1]}"
}

require_owner() {
  validate_agent "$AGENT"
  local owner="$(fm_get "$1" owner)"
  [[ -n "$owner" ]] || die "REFUSED: task is unclaimed — run: task claim $nnn"
  [[ "$owner" == "$AGENT" ]] || die "REFUSED: $nnn owned by '$owner', not '$AGENT'. Take over explicitly: task claim $nnn --force"
}

filled_handoff() { # Structural gate only; humans still judge evidence and decisions.
  local -a files
  files=("$1"/handoffs/*.md(N.))
  (( ${#files} > 0 )) || return 1
  awk '
    BEGIN { split("Objective Completed Pending Blockers Decisions", required, " ") }
    {
      line=$0; clean=""
      while (length(line)) {
        if (comment) {
          end=index(line,"-->"); if (!end) break
          line=substr(line,end+3); comment=0
        } else {
          start=index(line,"<!--")
          if (!start) { clean=clean line; break }
          clean=clean substr(line,1,start-1); line=substr(line,start+4); comment=1
        }
      }
      if (clean ~ /^## /) { section=substr(clean,4); sub(/[[:space:]]+$/,"",section); next }
      if (clean !~ /^#/ && clean ~ /[[:alnum:]]/) filled[section]=1
    }
    END { for (i in required) if (!filled[required[i]]) exit 1 }
  ' "${files[-1]}"
}

cmd="${1:-}"; [ -n "$cmd" ] && shift || usage
case "$cmd" in
  new)
    (( $# >= 1 && $# <= 2 )) || usage
    title="${1:?title required}"; prio="${2:-P2}"
    [[ "$title" != *[[:cntrl:]]* && "$title" == *[^[:space:]]* ]] || die "title must be nonblank and contain no control characters"
    [[ "$prio" =~ '^P[0-3]$' ]] || die "priority must be P0, P1, P2 or P3"
    slug=$(printf '%s\n' "$title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g;s/--*/-/g;s/^-//;s/-$//' | cut -c1-40)
    slug="${slug:-task}"
    existing=("$TASKS_DIR"/<->-*(N/))
    last=0
    for e in $existing; do
      n=${${e:t}%%-*}
      validate_id "$n"
      (( 10#$n > last )) && last=$((10#$n))
    done
    nnn=$(printf '%03d' $(( last + 1 )))
    validate_id "$nnn"
    dir="$TASKS_DIR/$nnn-$slug"
    mkdir -p "$dir/handoffs"
    quote="'"; serialized_title="${title//$quote/$quote$quote}"
    cat > "$dir/task.md" <<EOF
---
id: $nnn
title: '$serialized_title'
status: pending
owner:
priority: $prio
depends_on:
lane:
design:
pr:
created: $(now)
updated: $(now)
---

## Scope

## Acceptance criteria

## Decisions
<!-- settled choices + rejected alternatives, with why -->
EOF
    echo "$dir/task.md"
    ;;
  claim)
    nnn="${1:?task number required}"; shift
    force=0; owner=""
    for a in "$@"; do
      if [ "$a" = "--force" ]; then force=1
      elif [[ "$a" == --* || -n "$owner" ]]; then usage
      else owner="$a"
      fi
    done
    owner="${owner:-$AGENT}"
    validate_agent "$owner"
    f="$(task_dir "$nnn")/task.md"
    cur=$(fm_get "$f" owner)
    if [ -n "$cur" ] && [ "$cur" != "$owner" ] && [ $force -eq 0 ]; then
      echo "REFUSED: $nnn owned by '$cur'. Take over explicitly: task claim $nnn $owner --force" >&2
      exit 1
    fi
    fm_set "$f" owner "$owner"; fm_set "$f" status active; fm_set "$f" updated "$(now)"
    echo "claimed $nnn -> $owner"
    ;;
  status)
    (( $# == 2 )) || usage
    nnn="${1:?}"; st="${2:?pending|active|review|blocked}"
    case "$st" in
      pending|active|review|blocked) ;;
      done) echo "REFUSED: 'status done' bypasses the closeout gate — use: task done $nnn" >&2; exit 1;;
      *) echo "bad status: $st" >&2; exit 1;;
    esac
    f="$(task_dir "$nnn")/task.md"
    require_owner "$f"
    fm_set "$f" status "$st"; fm_set "$f" updated "$(now)"
    echo "$nnn -> $st"
    ;;
  done)
    nnn="${1:?}"; shift; d="$(task_dir "$nnn")"; f="$d/task.md"
    check=0; force=0
    for a in "$@"; do
      case "$a" in
        --check) check=1;;
        --force) force=1;;
        *) echo "bad flag: $a (expected --check or --force)" >&2; exit 1;;
      esac
    done
    (( check )) || require_owner "$f"
    problems=()
    filled_handoff "$d" || problems+=("latest Markdown handoff needs content in Objective, Completed, Pending, Blockers and Decisions — run: task handoff $nnn and fill it in")
    dz=$(fm_get "$f" design)
    if [ -n "$dz" ]; then
      if [ -f "$dz" ]; then
        ds=$(fm_get "$dz" status)
        case "$ds" in
          implemented|superseded) ;;
          *) problems+=("design doc $dz status is '${ds:-none}' — migrate shipped sections to docs/architecture|specs, set status: implemented") ;;
        esac
      else
        problems+=("design: points at missing file '$dz' — fix the path, or clear design: after migration")
      fi
    fi
    if (( check )); then
      if (( ${#problems} > 0 )); then
        echo "NOT CLOSEABLE: task $nnn" >&2
        for p in $problems; do echo "  - $p" >&2; done
        exit 1
      fi
      echo "closeable: task $nnn"; exit 0
    fi
    if (( ${#problems} > 0 )) && (( ! force )); then
      echo "REFUSED: task $nnn not closeable:" >&2
      for p in $problems; do echo "  - $p" >&2; done
      echo "(override: task done $nnn --force — justify in the final handoff)" >&2
      exit 1
    fi
    fm_set "$f" status done; fm_set "$f" updated "$(now)"
    "$0" index >/dev/null
    echo "$nnn -> done"
    cat <<EOF
closeout checklist (judgment items):
  - PR merged, branch task/$nnn-* deleted, pr: recorded in task.md
  - design doc shrunk to pointer or deleted after migration
  - durable decisions promoted task.md -> AGENTS.md bible
  - prototypes kept only if living reference; spikes killed
  - regression tests named after behavior, green
EOF
    ;;
  handoff)
    (( $# == 1 )) || usage
    validate_agent "$AGENT"
    nnn="${1:?}"; d="$(task_dir "$nnn")"
    require_owner "$d/task.md"
    mkdir -p "$d/handoffs"
    prefix="$d/handoffs/$(stamp)-$AGENT"
    sequence=1
    while true; do
      hf="$prefix-$(printf '%06d' $sequence).md"
      # Reserve a fresh path exclusively; never truncate an existing handoff.
      if (setopt noclobber; : > "$hf") 2>/dev/null; then break; fi
      [[ -e "$hf" ]] || die "cannot create handoff in $d/handoffs"
      (( sequence++ ))
    done
    cat > "$hf" <<EOF
# Handoff — task $nnn — $AGENT — $(now)
<!-- IMMUTABLE once committed. Next session writes a NEW file. -->

## Objective
<!-- standing goal, verbatim, incl. numeric targets -->

## Completed
<!-- with evidence pointers: run dirs, commits, file:line -->

## Pending
<!-- ordered, cheapest/highest-signal first -->

## Blockers
<!-- exact state: what runs, what waits on whom -->

## Decisions
<!-- settled this session + rejected alternatives (why) -->
EOF
    echo "$hf"
    ;;
  release)
    (( $# == 1 )) || usage
    nnn="$1"; d="$(task_dir "$nnn")"; f="$d/task.md"
    require_owner "$f"
    filled_handoff "$d" || die "REFUSED: release needs a filled latest Markdown handoff (Objective, Completed, Pending, Blockers, Decisions)"
    fm_set "$f" owner ""; fm_set "$f" status pending; fm_set "$f" updated "$(now)"
    "$0" index >/dev/null
    echo "released $nnn -> pending (unclaimed)"
    ;;
  index|board)
    (( $# == 0 )) || usage
    rows=""
    for f in "$TASKS_DIR"/<->-*/task.md(N); do
      id=$(fm_get "$f" id); ti=$(fm_get "$f" title); st=$(fm_get "$f" status)
      ow=$(fm_get "$f" owner); pr=$(fm_get "$f" priority); up=$(fm_get "$f" updated)
      lh=$(ls "${f%/task.md}/handoffs" 2>/dev/null | sort | tail -1)
      ti="${ti//|/&#124;}"
      rows+="$st|$pr|$id|$ti|${ow:--}|${up%T*}|${lh:--}"$'\n'
    done
    render() {
      echo "| id | title | status | owner | prio | updated | latest handoff |"
      echo "|---|---|---|---|---|---|---|"
      for st in active review blocked pending done; do
        printf '%s' "$rows" | awk -F'|' -v s="$st" '$1==s' | sort -t'|' -k2,2 -k3,3n | \
          awk -F'|' '{printf "| %s | %s | **%s** | %s | %s | %s | %s |\n",$3,$4,$1,$5,$2,$6,$7}'
      done
    }
    if [ "$cmd" = "board" ]; then render; exit 0; fi
    out="$TASKS_DIR/TASKS.md"
    {
      echo "# Task Board"
      echo
      echo "> GENERATED by \`task index\` — never hand-edit. Source of truth: \`tasks/NNN-*/task.md\`"
      echo "> frontmatter (single writer: the owner). Continuation: latest file in the task's \`handoffs/\`."
      echo
      render
    } > "$out"
    echo "wrote $out"
    ;;
  *) usage ;;
esac
